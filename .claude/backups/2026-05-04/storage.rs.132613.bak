use std::collections::HashMap;

// Mutation - the canonical event type
// Every state-changing operation passes through here
#[derive(Debug, PartialEq, Clone)]
pub enum Mutation {
    Set { key: String, value: StoredValue },
    Del { key: String },
    Incr { key: String, by: u64 },
    Decr { key: String, by: u64 },
}

//MutationOutcome - what apply() returns on success
// Initial variants; will grow as TDD locks per-mutation semantics
#[derive(Debug, PartialEq, Clone)]
pub enum MutationOutcome {
    Stored,
    Deleted,
    Counter { new_value: u64 },
}

//Will add more when writing tests
#[derive(Debug, PartialEq, thiserror::Error)]
pub enum StorageError {
    #[error("not an integer")]
    NotAnInteger,
    #[error("counter overflow")]
    Overflow,
    #[error("counter underflow")]
    Underflow,
}

//Storage - contrat every backend must satisfy
pub trait Storage {
    fn apply(&mut self, mutation: Mutation) -> Result<MutationOutcome, StorageError>;
    fn read(&self, key: &str) -> Option<StoredValue>;
    fn exists(&self, key: &str) -> bool;
}
#[derive(Debug, PartialEq, Clone)]
pub enum StoredValue {
    Str(String),
    Int(u64),
}
impl StoredValue {
    /// Infer a `StoredValue` from a textual argument.
    /// Numeric tokens that fit in `u64` become `Int`; everything else becomes `Str`.
    /// Used by the executor to type REPL input on entry.
    pub fn from_text(s: &str) -> Self {
        match s.parse::<u64>() {
            Ok(n) => StoredValue::Int(n),
            Err(_) => StoredValue::Str(s.to_string()),
        }
    }
}
impl From<&str> for StoredValue {
    fn from(s: &str) -> Self {
        StoredValue::Str(s.to_string())
    }
}
impl From<u64> for StoredValue {
    fn from(n: u64) -> Self {
        StoredValue::Int(n)
    }
}
// InMemoryStorage
#[derive(Debug, Default)]
pub struct InMemoryStorage {
    data: HashMap<String, StoredValue>,
}
impl InMemoryStorage {
    pub fn new() -> Self {
        Self::default()
    }
    fn apply_counter_op<F>(&mut self, key: String, op: F) -> Result<MutationOutcome, StorageError>
    where
        F: FnOnce(u64) -> Result<u64, StorageError>,
    {
        let current: u64 = match self.data.get(&key) {
            Some(StoredValue::Int(n)) => *n,
            Some(StoredValue::Str(_)) => return Err(StorageError::NotAnInteger),
            None => 0,
        };
        let new_value = op(current)?;
        self.data.insert(key, StoredValue::Int(new_value));
        Ok(MutationOutcome::Counter { new_value })
    }
}

//Helper functions:

impl Storage for InMemoryStorage {
    fn apply(&mut self, mutation: Mutation) -> Result<MutationOutcome, StorageError> {
        match mutation {
            Mutation::Set { key, value } => {
                self.data.insert(key, value);
                Ok(MutationOutcome::Stored)
            }
            Mutation::Incr { key, by } => {
                self.apply_counter_op(key, |c| c.checked_add(by).ok_or(StorageError::Overflow))
            }
            Mutation::Decr { key, by } => {
                self.apply_counter_op(key, |c| c.checked_sub(by).ok_or(StorageError::Underflow))
            }
            Mutation::Del { key } => {
                self.data.remove(&key);
                Ok(MutationOutcome::Deleted)
            }
        }
    }
    fn read(&self, key: &str) -> Option<StoredValue> {
        self.data.get(key).cloned()
    }
    fn exists(&self, key: &str) -> bool {
        self.data.contains_key(key)
    }
}

#[cfg(test)]
pub(crate) mod contract {
    //! Generic contract tests for any `impl Storage`. Per ADR 0006.
    //!
    //! Each fn takes a freshly-constructed storage by `&mut` and asserts a
    //! behavior the contract requires. Future Storage backends (e.g.
    //! `WalBackedStorage` at M3) become contract-conformant by adding a
    //! thin wrapper module that delegates each `#[test]` to the contract
    //! fn of the same name.
    use super::*;
    use pretty_assertions::assert_eq;

    pub fn set_returns_stored<S: Storage>(storage: &mut S) {
        let result = storage.apply(Mutation::Set {
            key: String::from("foo"),
            value: "bar".into(),
        });
        assert_eq!(result, Ok(MutationOutcome::Stored));
    }

    pub fn del_returns_deleted_on_empty<S: Storage>(storage: &mut S) {
        let result = storage.apply(Mutation::Del {
            key: String::from("foo"),
        });
        assert_eq!(result, Ok(MutationOutcome::Deleted));
    }

    pub fn incr_on_missing_starts_from_zero<S: Storage>(storage: &mut S) {
        let result = storage.apply(Mutation::Incr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Ok(MutationOutcome::Counter { new_value: 1 }));
    }

    pub fn incr_on_existing_int_adds<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: 5.into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Incr {
            key: String::from("foo"),
            by: 3,
        });
        assert_eq!(result, Ok(MutationOutcome::Counter { new_value: 8 }));
        assert_eq!(storage.read("foo"), Some(8.into()));
    }

    pub fn decr_on_existing_int_subtracts<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: 5.into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Decr {
            key: String::from("foo"),
            by: 3,
        });
        assert_eq!(result, Ok(MutationOutcome::Counter { new_value: 2 }));
        assert_eq!(storage.read("foo"), Some(2.into()));
    }

    pub fn incr_on_str_errors_and_preserves<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "hello".into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Incr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::NotAnInteger));
        assert_eq!(storage.read("foo"), Some("hello".into()));
    }

    pub fn decr_on_str_errors_and_preserves<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "hello".into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Decr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::NotAnInteger));
        assert_eq!(storage.read("foo"), Some("hello".into()));
    }

    pub fn incr_overflow_errors_and_preserves<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: u64::MAX.into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Incr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::Overflow));
        assert_eq!(storage.read("foo"), Some(u64::MAX.into()));
    }

    pub fn decr_underflow_errors_and_preserves<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: 0.into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Decr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::Underflow));
        assert_eq!(storage.read("foo"), Some(0.into()));
    }

    pub fn del_removes_existing_value<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "bar".into(),
            })
            .unwrap();
        storage
            .apply(Mutation::Del {
                key: String::from("foo"),
            })
            .unwrap();
        assert!(!storage.exists("foo"));
        assert_eq!(storage.read("foo"), None);
    }

    pub fn read_returns_none_for_missing<S: Storage>(storage: &mut S) {
        assert_eq!(storage.read("foo"), None);
    }

    pub fn read_returns_some_after_set<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "bar".into(),
            })
            .unwrap();
        assert_eq!(storage.read("foo"), Some("bar".into()));
    }

    pub fn exists_returns_false_for_missing<S: Storage>(storage: &mut S) {
        assert!(!storage.exists("foo"));
    }

    pub fn exists_returns_true_after_set<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "bar".into(),
            })
            .unwrap();
        assert!(storage.exists("foo"));
    }

    pub fn incr_on_numeric_string_errors<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "5".into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Incr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::NotAnInteger));
        assert_eq!(storage.read("foo"), Some("5".into()));
    }

    pub fn decr_on_numeric_string_errors<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "5".into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Decr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::NotAnInteger));
        assert_eq!(storage.read("foo"), Some("5".into()));
    }

    pub fn set_can_store_int_variant<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: 42u64.into(),
            })
            .unwrap();
        assert_eq!(storage.read("foo"), Some(StoredValue::Int(42)));
    }

    pub fn set_can_store_str_variant<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "hello".into(),
            })
            .unwrap();
        assert_eq!(
            storage.read("foo"),
            Some(StoredValue::Str(String::from("hello"))),
        );
    }

    pub fn set_can_overwrite_with_different_variant<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: 42u64.into(),
            })
            .unwrap();
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "now a string".into(),
            })
            .unwrap();
        assert_eq!(
            storage.read("foo"),
            Some(StoredValue::Str(String::from("now a string"))),
        );
    }

    pub fn incr_after_overwriting_int_with_str_errors<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: 5u64.into(),
            })
            .unwrap();
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "oops".into(),
            })
            .unwrap();
        let result = storage.apply(Mutation::Incr {
            key: String::from("foo"),
            by: 1,
        });
        assert_eq!(result, Err(StorageError::NotAnInteger));
    }

    pub fn del_on_missing_is_idempotent<S: Storage>(storage: &mut S) {
        let result = storage.apply(Mutation::Del {
            key: String::from("never_set"),
        });
        assert_eq!(result, Ok(MutationOutcome::Deleted));
        assert!(!storage.exists("never_set"));
    }

    pub fn del_twice_is_idempotent<S: Storage>(storage: &mut S) {
        storage
            .apply(Mutation::Set {
                key: String::from("foo"),
                value: "bar".into(),
            })
            .unwrap();
        storage
            .apply(Mutation::Del {
                key: String::from("foo"),
            })
            .unwrap();
        let second = storage.apply(Mutation::Del {
            key: String::from("foo"),
        });
        assert_eq!(second, Ok(MutationOutcome::Deleted));
        assert!(!storage.exists("foo"));
    }
}

#[cfg(test)]
mod in_memory_contract_tests {
    //! Conformance: `InMemoryStorage` passes the Storage contract.
    //!
    //! Each `#[test]` is a thin wrapper that creates a fresh
    //! `InMemoryStorage` and runs the named contract fn against it.
    use super::*;

    /// Generate a `#[test]` that calls `contract::$name(&mut storage)`.
    /// Local declarative macro (`macro_rules!`) — collapses the per-test
    /// boilerplate "make storage, call contract fn" into one line per test.
    macro_rules! delegate {
        ($name:ident) => {
            #[test]
            fn $name() {
                let mut s = InMemoryStorage::new();
                contract::$name(&mut s);
            }
        };
    }

    delegate!(set_returns_stored);
    delegate!(del_returns_deleted_on_empty);
    delegate!(incr_on_missing_starts_from_zero);
    delegate!(incr_on_existing_int_adds);
    delegate!(decr_on_existing_int_subtracts);
    delegate!(incr_on_str_errors_and_preserves);
    delegate!(decr_on_str_errors_and_preserves);
    delegate!(incr_overflow_errors_and_preserves);
    delegate!(decr_underflow_errors_and_preserves);
    delegate!(del_removes_existing_value);
    delegate!(read_returns_none_for_missing);
    delegate!(read_returns_some_after_set);
    delegate!(exists_returns_false_for_missing);
    delegate!(exists_returns_true_after_set);
    delegate!(incr_on_numeric_string_errors);
    delegate!(decr_on_numeric_string_errors);
    delegate!(set_can_store_int_variant);
    delegate!(set_can_store_str_variant);
    delegate!(set_can_overwrite_with_different_variant);
    delegate!(incr_after_overwriting_int_with_str_errors);
    delegate!(del_on_missing_is_idempotent);
    delegate!(del_twice_is_idempotent);
}

#[cfg(test)]
mod from_text_tests {
    //! Tests for `StoredValue::from_text` — the inference rule that lives
    //! at the executor boundary. Not part of the Storage trait, so not
    //! included in the contract.
    use super::*;
    use pretty_assertions::assert_eq;
    use proptest::prelude::*;

    #[test]
    fn infers_int_for_numeric_token() {
        let result = StoredValue::from_text("5");
        assert_eq!(result, StoredValue::Int(5));
    }

    #[test]
    fn infers_str_for_non_numeric_token() {
        let result = StoredValue::from_text("foo");
        assert_eq!(result, StoredValue::Str(String::from("foo")));
    }

    #[test]
    fn infers_str_for_negative_token() {
        let result = StoredValue::from_text("-5");
        assert_eq!(result, StoredValue::Str(String::from("-5")));
    }

    #[test]
    fn infers_str_for_decimal_token() {
        let result = StoredValue::from_text("3.14");
        assert_eq!(result, StoredValue::Str(String::from("3.14")));
    }

    #[test]
    fn infers_str_for_overflow_token() {
        let result = StoredValue::from_text("18446744073709551616");
        assert_eq!(
            result,
            StoredValue::Str(String::from("18446744073709551616")),
        );
    }

    #[test]
    fn infers_int_for_zero() {
        // Boundary: parse::<u64>() accepts "0" → Int(0).
        assert_eq!(StoredValue::from_text("0"), StoredValue::Int(0));
    }

    #[test]
    fn infers_int_for_u64_max() {
        // Symmetric to the overflow test: u64::MAX exactly should succeed as Int.
        assert_eq!(
            StoredValue::from_text("18446744073709551615"),
            StoredValue::Int(u64::MAX),
        );
    }

    #[test]
    fn infers_str_for_empty_string() {
        // "".parse::<u64>() errors → falls to Str("").
        // The executor path won't normally see this (split_whitespace strips it),
        // but locking the semantic protects against future input sources.
        assert_eq!(StoredValue::from_text(""), StoredValue::Str(String::new()));
    }
}
